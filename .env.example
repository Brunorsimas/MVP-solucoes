# Private connection string from the PostgreSQL provider; never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT-HOST/DATABASE?sslmode=verify-full
# Neon CLI writes real service values to the gitignored .env.local.
NEON_AUTH_BASE_URL=https://AUTH-HOST/neondb/auth
NEON_AUTH_JWKS_URL=https://AUTH-HOST/neondb/auth/.well-known/jwks.json
NEON_FUNCTION_HELLO_BASE_URL=https://FUNCTION-HOST/
# Optional: PILOT_TIME=10 allows test requests outside business hours.
# Omit in normal operation to use 08:00-19:00 in America/Recife.
PILOT_TIME=
