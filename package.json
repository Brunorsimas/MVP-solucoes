{
  "name": "mvp-solucoes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/start.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/build.mjs",
    "build:shared": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/build.mjs --shared",
    "build:static": "node scripts/build.mjs --static",
    "preview:shared": "node scripts/shared-preview.mjs",
    "preview:test-login": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-login-preview.mjs",
    "db:init": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/database.mjs init",
    "db:specialist": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/database.mjs specialist",
    "db:neon-specialist": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/neon-specialist.mjs",
    "test:neon": "node --env-file-if-exists=.env.neon-test scripts/neon-e2e.mjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check public/domain.js && node --check public/demo.js && node --check public/drafts.js && node --check lib/postgres-store.mjs && node --check lib/shared-api.mjs && node --check netlify/functions/api.mjs && node --check netlify/functions/retention.mjs && node --check public/neon-client.js && node --check lib/neon-api.mjs && node --check functions/mvpapi.mjs && node --check scripts/start.mjs && node --check scripts/neon-specialist.mjs && node --check scripts/neon-e2e.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@neon/functions": "^0.11.0",
    "@neondatabase/auth": "^0.6.0-beta",
    "jose": "^6.2.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "esbuild": "^0.28.2"
  }
}
